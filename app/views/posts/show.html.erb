<% content_for :title, @post.title %>

<article class="max-w-4xl mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 dark:bg-green-900/30 mb-5 text-green-500 dark:text-green-300 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <!-- Featured Image -->
  <% if @post.display_image %>
    <div class="mb-8">
      <%= image_tag @post.display_image, class: "w-full h-64 md:h-96 object-cover rounded-lg shadow-lg" %>
    </div>
  <% end %>

  <!-- Post Header -->
  <header class="mb-8">
    <h1 class="font-bold text-4xl md:text-5xl text-gray-900 dark:text-gray-100 mb-4"><%= @post.title %></h1>
    <% if @post.category %>
      <span class="inline-block px-3 py-1 text-sm bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 rounded-full">
        <%= @post.category.name %>
      </span>
    <% end %>
  </header>

  <!-- Post Content -->
  <% if @post.content.present? %>
    <div class="prose prose-lg max-w-none mb-8 text-gray-800 dark:text-gray-200">
      <%= simple_format(@post.content) %>
    </div>
  <% end %>

  <!-- Additional Attachments -->
  <% if @post.attachments.attached? %>
    <div class="mb-8 p-6 bg-gray-50 dark:bg-slate-800 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Attachments</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <% @post.attachments.each do |file| %>
          <div class="text-center">
            <% if file.image? %>
              <%= link_to rails_blob_path(file), target: "_blank" do %>
                <%= image_tag file, class: "w-full h-24 object-cover rounded border hover:shadow-md transition-shadow" %>
              <% end %>
            <% else %>
              <%= link_to rails_blob_path(file, disposition: "attachment"), class: "block p-4 bg-white dark:bg-slate-900 rounded border hover:shadow-md transition-shadow" do %>
                <div class="text-center">
                  <div class="text-2xl mb-2">📎</div>
                  <div class="text-xs text-gray-600 dark:text-gray-300 truncate"><%= file.filename %></div>
                </div>
              <% end %>
            <% end %>
            <div class="mt-2">
              <%= button_to "Remove", remove_attachment_post_path(@post, attachment_id: file.id), method: :delete, class: "text-xs text-red-600 dark:text-red-300 hover:text-red-800 dark:hover:text-red-400", form: { data: { turbo_confirm: "Remove this file?" } } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Action Buttons -->
  <div class="flex flex-wrap gap-2 pt-6 border-t border-gray-200 dark:border-slate-700">
    <%= link_to "Edit this post", edit_post_path(@post), class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium" %>
    <%= link_to "Upload more files", edit_post_path(@post, anchor: "attachments"), class: "rounded-md px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium" %>
    <%= link_to "Back to posts", posts_path, class: "rounded-md px-4 py-2 bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-800 dark:text-slate-100 font-medium" %>
    <%= button_to "Delete this post", @post, method: :delete, class: "rounded-md px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</article>

<% content_for :title, "Posts" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 dark:bg-green-900/30 mb-5 text-green-700 dark:text-green-300 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">
      Posts
      <% if defined?(@category) && @category %>
        <span class="text-2xl text-gray-600">- <%= @category.name %></span>
      <% end %>
    </h1>
    <%= link_to "New post", new_post_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <!-- Category Menu -->
  <div class="my-6">
    <nav class="flex space-x-4 overflow-x-auto">
      <%= link_to "All Categories", posts_path, 
          class: "px-4 py-2 rounded-md #{'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' unless params[:category_id]} #{'bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-100' if params[:category_id]} whitespace-nowrap font-medium" %>
      <% @categories.each do |category| %>
        <%= link_to category.name, posts_path(category_id: category.id), 
            class: "px-4 py-2 rounded-md #{params[:category_id] == category.id.to_s ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-100'} whitespace-nowrap font-medium" %>
      <% end %>
    </nav>
  </div>

  <div id="posts" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <div class="relative">
          <%= render post %>
          <div class="absolute top-2 right-2 flex space-x-1">
            <%= link_to "👁", post, class: "bg-white bg-opacity-80 hover:bg-opacity-100 rounded-full p-2 text-sm shadow", title: "Show" %>
            <%= link_to "✏", edit_post_path(post), class: "bg-white bg-opacity-80 hover:bg-opacity-100 rounded-full p-2 text-sm shadow", title: "Edit" %>
            <%= button_to "🗑", post, method: :delete, class: "bg-white bg-opacity-80 hover:bg-opacity-100 rounded-full p-2 text-sm shadow border-0 cursor-pointer", title: "Delete", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-span-full">
        <p class="text-center my-10 text-gray-500">No posts found.</p>
      </div>
    <% end %>
  </div>
</div>

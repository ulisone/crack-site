<div id="<%= dom_id post %>" class="w-full sm:w-auto my-5 bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
  <% if post.display_image %>
    <div class="aspect-w-16 aspect-h-9">
      <%= image_tag post.display_image, class: "w-full h-48 object-cover" %>
    </div>
  <% else %>
    <div class="h-48 bg-gray-200 dark:bg-slate-700 flex items-center justify-center">
      <div class="text-center text-gray-500 dark:text-gray-300">
        <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <p class="text-sm">No image</p>
      </div>
    </div>
  <% end %>
  
  <div class="p-5 space-y-3">
    <div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">
        <%= post.title %>
        <% if post.category %>
          <span class="inline-block px-2 py-1 text-xs bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300 rounded-md ml-2">
            <%= post.category.name %>
          </span>
        <% end %>
      </h3>
    </div>
    
    <% if post.content.present? %>
      <div class="text-gray-700 dark:text-gray-300">
        <%= truncate(post.content, length: 150) %>
      </div>
    <% end %>
    
    <% if post.attachments.attached? %>
      <div class="mt-3 pt-3 border-t border-gray-100 dark:border-slate-700">
        <p class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Attachments:</p>
        <div class="flex flex-wrap gap-2">
          <% post.attachments.each do |file| %>
            <div class="flex items-center bg-gray-50 dark:bg-slate-700 rounded px-2 py-1">
              <%= link_to file.filename, rails_blob_path(file, disposition: "attachment"), class: "text-sm text-blue-600 dark:text-blue-300 hover:text-blue-800 dark:hover:text-blue-200" %>
              <%= button_to "×", remove_attachment_post_path(post, attachment_id: file.id), method: :delete, class: "ml-1 text-red-500 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 text-sm", form: { data: { turbo_confirm: "Remove this file?" } } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

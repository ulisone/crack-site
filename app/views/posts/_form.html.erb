<%= form_with(model: post, class: "contents") do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul class="list-disc ml-6">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title %>
    <%= form.text_field :title, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": post.errors[:title].none?, "border-red-400 focus:outline-red-600": post.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :content %>
    <%= form.textarea :content, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": post.errors[:content].none?, "border-red-400 focus:outline-red-600": post.errors[:content].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :category_id, "Category" %>
    <%= form.select :category_id, 
        options_from_collection_for_select(@categories, :id, :name, post.category_id),
        { prompt: "Select a category (optional)" },
        { class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" } %>
  </div>

  <div class="my-5">
    <%= form.label :featured_image, "Featured Image" %>
    <%= form.file_field :featured_image, accept: "image/*", direct_upload: true, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
    <p class="text-sm text-gray-500 mt-1">Choose a main image for this post (optional). If not selected, the first image from attachments will be used.</p>
    <% if post.featured_image.attached? %>
      <div class="mt-2">
        <p class="text-sm text-gray-600">Current featured image:</p>
        <%= image_tag post.featured_image, class: "w-32 h-24 object-cover rounded-md mt-1" %>
      </div>
    <% end %>
  </div>

  <div class="my-5">
    <%= form.label :attachments, "Attachments" %>
    <%= form.file_field :attachments, multiple: true, direct_upload: true, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>

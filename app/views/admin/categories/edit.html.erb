<% content_for :title, "Editing Category" %>

<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing <%= @category.name %></h1>

  <%= render "form", category: @category %>

  <div class="mt-6 flex space-x-2">
    <%= link_to "Show this category", admin_category_path(@category), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-200 inline-block font-medium" %>
    <%= link_to "Back to categories", admin_categories_path, class: "ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-200 inline-block font-medium" %>
  </div>
</div>

<% content_for :title, "Categories" %>

<div class="w-full space-y-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 dark:bg-green-900/30 mb-5 text-green-700 dark:text-green-300 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm uppercase tracking-wide text-gray-500 dark:text-gray-400">Categories</p>
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100">Organize your posts</h1>
      <p class="text-gray-500 dark:text-gray-400 mt-2">Create, edit, and explore categories to group related posts.</p>
    </div>
    <div class="flex gap-3">
      <%= link_to "New category", new_category_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" id="categories">
    <% if @categories.any? %>
      <% @categories.each do |category| %>
        <div class="rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm uppercase tracking-wide text-gray-400 dark:text-gray-500">Category</p>
              <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100"><%= category.name %></h2>
            </div>
            <span class="rounded-full bg-blue-50 dark:bg-blue-900/30 px-3 py-1 text-sm font-medium text-blue-700 dark:text-blue-300">
              <%= pluralize(category.posts.size, "post") %>
            </span>
          </div>
          <p class="text-gray-600 dark:text-gray-300"><%= category.description.presence || "No description provided." %></p>
          <div class="flex flex-wrap gap-2 text-sm">
            <%= link_to "View", category_path(category), class: "rounded-md border border-gray-200 dark:border-slate-600 px-3 py-1.5 hover:bg-gray-50 dark:hover:bg-slate-800" %>
            <%= link_to "Edit", edit_category_path(category), class: "rounded-md border border-gray-200 dark:border-slate-600 px-3 py-1.5 hover:bg-gray-50 dark:hover:bg-slate-800" %>
            <%= button_to "Delete", category_path(category), method: :delete, data: { turbo_confirm: "Delete #{category.name}?" }, class: "rounded-md border border-red-200 dark:border-red-500/50 px-3 py-1.5 text-red-600 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-900/20" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-span-full rounded-xl border border-dashed border-gray-300 dark:border-slate-700 p-10 text-center text-gray-500 dark:text-gray-400">
        <p class="text-lg font-medium">No categories yet.</p>
        <p class="mt-2">Create your first category to start organizing posts.</p>
        <%= link_to "Create a category", new_category_path, class: "mt-4 inline-flex items-center justify-center rounded-md bg-blue-600 px-4 py-2 text-white font-semibold shadow-sm hover:bg-blue-500" %>
      </div>
    <% end %>
  </div>
</div>
